{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudguard.local/schemas/secret.schema.json",
  "title": "Encrypted secret record",
  "description": "On-disk shape of the vault. Every value is ciphertext; a record never contains plaintext.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": { "const": 1 },
    "records": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$" },
      "additionalProperties": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "created_at", "updated_at", "envelope"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "integer", "minimum": 0 },
        "envelope": { "$ref": "#/$defs/envelope" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "alg", "name", "dek_wrapped", "dek_nonce", "nonce", "ciphertext"],
      "properties": {
        "v": { "const": 1 },
        "alg": { "const": "AES-256-GCM" },
        "name": {
          "type": "string",
          "description": "Bound as associated data; a ciphertext moved to another name will not open."
        },
        "dek_wrapped": {
          "type": "string",
          "description": "base64url, 32-byte data key encrypted with the master key + 16-byte tag"
        },
        "dek_nonce": { "type": "string", "description": "base64url, 12 bytes" },
        "nonce": { "type": "string", "description": "base64url, 12 bytes" },
        "ciphertext": { "type": "string", "description": "base64url, value ciphertext + 16-byte tag" }
      }
    }
  }
}
