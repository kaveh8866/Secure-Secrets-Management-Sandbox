# =============================================================================
# Secure Secrets Management Sandbox — environment template
# =============================================================================
# Copy to `.env` (gitignored) and replace every value before using this anywhere
# that matters. The values below are publicly known mocks: they exist so the
# stack starts and the smoke test can run, NOT so you can skip replacing them.
#
# Generate real values:
#   python -m secretsd --generate-key          # 43-char base64url master key
#   python -m secretsd --hash-token < token    # sha256 for configs/policies.toml

# --- Cryptography ------------------------------------------------------------
# Master key (KEK) that wraps per-secret data keys. 32 bytes, base64url.
# Losing it loses every secret: back it up outside this repository.
SECRETSD_MASTER_KEY=Y2ctc2FuZGJveC1tb2NrLWtleS0zMi1ieXRlcy0hISE

# Optional: read the master key from a file instead (mounted secret, KMS). Set
# one or the other, never both.
# SECRETSD_MASTER_KEY_FILE=/run/secrets/secretsd-master-key

# --- Bootstrap token ---------------------------------------------------------
# Full-privilege token, hashed in memory at boot. Rotate it by changing this
# value and restarting; secrets stay readable because they are not encrypted
# with it.
SECRETSD_ROOT_TOKEN=cg_mock_root_token_change_me

# --- Service behaviour -------------------------------------------------------
SECRETSD_BIND_ADDRESS=127.0.0.1
SECRETSD_HOST_PORT=8200
SECRETSD_ALLOW_API_ROTATION=false
TZ=UTC

# --- OCI (Stage 2, OpenTofu) -------------------------------------------------
# Placeholders use hyphens on purpose so they can never be mistaken for a live
# OCID. A real tenancy identifier belongs in terraform/terraform.tfvars only.
OCI_REGION=eu-frankfurt-1
OCI_TENANCY_OCID=ocid1.tenancy.oc1..placeholder-not-a-real-ocid
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..placeholder-not-a-real-ocid
OCI_AVAILABILITY_DOMAIN=example:EU-FRANKFURT-1-AD-2
OCI_INSTANCE_SHAPE=VM.Standard.A1.Flex
